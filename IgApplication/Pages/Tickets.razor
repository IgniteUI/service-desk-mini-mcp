@page "/tickets"
@inject TicketService TicketSvc
@inject NotificationService Notifications

<PageTitle>Tickets – Service Desk Mini</PageTitle>

<!-- Form dialog & confirm dialog (hidden until triggered) -->
<TicketFormDialog @ref="_formDialog" OnSaved="RefreshAsync" />
<ConfirmDeleteDialog @ref="_confirmDialog" OnConfirmed="DeleteConfirmedAsync" />

@if (_isLoading)
{
    <div class="loading-overlay">
        <IgbCircularProgress Indeterminate="true" />
        <span>Loading tickets...</span>
    </div>
}
else
{
    <div class="page-header">
        <h1>Tickets</h1>
        <p>Manage and track all support tickets.</p>
    </div>

    <!-- ── Toolbar ──────────────────────────────── -->
    <div class="grid-toolbar">

        <!-- Search -->
        <IgbInput @bind-Value="_searchText"
                  Placeholder="Search tickets..."
                  style="min-width:240px">
            <svg slot="prefix" width="16" height="16" viewBox="0 0 24 24" fill="#94a3b8">
                <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
        </IgbInput>

        <!-- Status filter -->
        <IgbSelect @ref="_statusFilter"
                   Label="Status"
                   Placeholder="All statuses"
                   style="min-width:140px">
            <IgbSelectItem Value="" Selected="@(_filterStatus == "")">All Statuses</IgbSelectItem>
            @foreach (var s in Enum.GetValues<TicketStatus>())
            {
                <IgbSelectItem Value="@s.ToString()" Selected="@(_filterStatus == s.ToString())">
                    @GetStatusLabel(s.ToString())
                </IgbSelectItem>
            }
        </IgbSelect>

        <!-- Priority filter -->
        <IgbSelect @ref="_priorityFilter"
                   Label="Priority"
                   Placeholder="All priorities"
                   style="min-width:140px">
            <IgbSelectItem Value="" Selected="@(_filterPriority == "")">All Priorities</IgbSelectItem>
            @foreach (var p in Enum.GetValues<TicketPriority>())
            {
                <IgbSelectItem Value="@p.ToString()" Selected="@(_filterPriority == p.ToString())">
                    @p.ToString()
                </IgbSelectItem>
            }
        </IgbSelect>

        <!-- Assignee filter -->
        <IgbSelect @ref="_assigneeFilter"
                   Label="Assignee"
                   Placeholder="All assignees"
                   style="min-width:150px">
            <IgbSelectItem Value="" Selected="@(_filterAssignee == "")">All Assignees</IgbSelectItem>
            @foreach (var a in TicketFormDialog.Assignees)
            {
                <IgbSelectItem Value="@a" Selected="@(_filterAssignee == a)">@a</IgbSelectItem>
            }
        </IgbSelect>

        <!-- Apply / Clear Filters -->
        <IgbButton Variant="ButtonVariant.Contained"
                   @onclick="ApplyFilters">
            Apply Filters
        </IgbButton>
        <IgbButton Variant="ButtonVariant.Outlined"
                   @onclick="ClearFilters">
            Clear
        </IgbButton>

        <span class="top-bar-spacer"></span>

        <!-- Add Ticket -->
        <IgbButton Variant="ButtonVariant.Contained"
                   @onclick="OpenAddDialog"
                   style="background:var(--sd-primary)">
            + Add Ticket
        </IgbButton>
    </div>

    <!-- ── Active filter chips ──────────────────── -->
    @if (!string.IsNullOrEmpty(_filterStatus) || !string.IsNullOrEmpty(_filterPriority) || !string.IsNullOrEmpty(_filterAssignee) || !string.IsNullOrEmpty(_searchText))
    {
        <div class="filter-chips">
            @if (!string.IsNullOrEmpty(_searchText))
            {
                <IgbChip Removable="true" Remove="@(() => { _searchText = ""; ApplyFilters(); })">
                    Search: @_searchText
                </IgbChip>
            }
            @if (!string.IsNullOrEmpty(_filterStatus))
            {
                <IgbChip Removable="true" Remove="@(() => { _filterStatus = ""; ApplyFilters(); })">
                    Status: @GetStatusLabel(_filterStatus)
                </IgbChip>
            }
            @if (!string.IsNullOrEmpty(_filterPriority))
            {
                <IgbChip Removable="true" Remove="@(() => { _filterPriority = ""; ApplyFilters(); })">
                    Priority: @_filterPriority
                </IgbChip>
            }
            @if (!string.IsNullOrEmpty(_filterAssignee))
            {
                <IgbChip Removable="true" Remove="@(() => { _filterAssignee = ""; ApplyFilters(); })">
                    Assignee: @_filterAssignee
                </IgbChip>
            }
        </div>
    }

    <!-- ── Tickets Grid ──────────────────────────── -->
    @if (_displayedTickets.Count == 0)
    {
        <div class="empty-state" style="background:white;border-radius:10px;border:1px solid var(--sd-border)">
            <div class="empty-icon">🔍</div>
            <p>No tickets match the current filters.</p>
            <IgbButton Variant="ButtonVariant.Flat" @onclick="ClearFilters" style="margin-top:8px">
                Clear Filters
            </IgbButton>
        </div>
    }
    else
    {
        <div class="ticket-count-bar">
            Showing <strong>@_displayedTickets.Count</strong> of <strong>@_allTickets.Count</strong> tickets
        </div>

        <IgbGrid Data="@_displayedTickets"
                 PrimaryKey="Id"
                 AutoGenerate="false"
                 Width="100%"
                 Height="580px"
                 DisplayDensity="DisplayDensity.Comfortable"
                 AllowFiltering="false">

            <IgbColumn Field="DisplayId" Header="Ticket #" Sortable="true">
                <BodyTemplate>
                    @{ var c = (IgbCellTemplateContext)context; }
                    <span class="ticket-id-cell">@c.Cell.Value</span>
                </BodyTemplate>
            </IgbColumn>

            <IgbColumn Field="Title" Header="Title" Sortable="true" />

            <IgbColumn Field="Customer" Header="Customer" Sortable="true" />

            <IgbColumn Field="Assignee" Header="Assignee" Sortable="true" />

            <IgbColumn Field="PriorityName" Header="Priority" Sortable="true">
                <BodyTemplate>
                    @{ var c2 = (IgbCellTemplateContext)context; var p = c2.Cell.Value?.ToString() ?? ""; }
                    <span class="badge @GetPriorityClass(p)">@p</span>
                </BodyTemplate>
            </IgbColumn>

            <IgbColumn Field="StatusName" Header="Status" Sortable="true">
                <BodyTemplate>
                    @{ var c3 = (IgbCellTemplateContext)context; var s = c3.Cell.Value?.ToString() ?? ""; }
                    <span class="badge @GetStatusClass(s)">@GetStatusLabel(s)</span>
                </BodyTemplate>
            </IgbColumn>

            <IgbColumn Field="CreatedDate" Header="Created" 
                       DataType="GridColumnDataType.Date" Sortable="true" />

            <IgbColumn Field="DueDate" Header="Due Date" 
                       DataType="GridColumnDataType.Date" Sortable="true">
                <BodyTemplate>
                    @{
                        var c4 = (IgbCellTemplateContext)context;
                        DateTime? dueDate = c4.Cell.Value is DateTime dv ? dv : null;
                        bool isOvd = dueDate.HasValue && dueDate.Value.Date < DateTime.Today;
                    }
                    <span style="@(isOvd ? "color:var(--sd-critical);font-weight:600" : "")">
                        @(dueDate.HasValue ? dueDate.Value.ToString("MM/dd/yyyy") : "—")
                        @(isOvd ? " ⚠" : "")
                    </span>
                </BodyTemplate>
            </IgbColumn>

            <!-- Actions column (uses Id field under the hood) -->
            <IgbColumn Field="Id" Header="Actions"
                       Sortable="false" Filterable="false" Editable="false"
                       >
                <BodyTemplate>
                    @{
                        var ca = (IgbCellTemplateContext)context;
                        var ticketId = ca.Cell.Value?.ToString() ?? "";
                        var ta = _displayedTickets.FirstOrDefault(t => t.Id == ticketId);
                    }
                    @if (ta != null)
                    {
                        <div class="grid-action-cell">
                            <IgbButton Variant="ButtonVariant.Flat"
                                       style="--ig-size:var(--ig-size-small)"
                                       @onclick="@(() => OpenViewDialog(ta))">
                                View
                            </IgbButton>
                            <IgbButton Variant="ButtonVariant.Flat"
                                       style="--ig-size:var(--ig-size-small)"
                                       @onclick="@(() => OpenEditDialog(ta))">
                                Edit
                            </IgbButton>
                            <IgbButton Variant="ButtonVariant.Flat"
                                       style="--ig-size:var(--ig-size-small);color:var(--sd-error)"
                                       @onclick="@(() => OpenDeleteConfirm(ta))">
                                Del
                            </IgbButton>
                        </div>
                    }
                </BodyTemplate>
            </IgbColumn>

            <!-- Paginator -->
            <IgbPaginator PerPage="10"
                          SelectOptions="@(new double[]{10,25,50})" />
        </IgbGrid>
    }
}

<!-- ── View Details Dialog ──────────────────────── -->
<IgbDialog @ref="_viewDialog"
           Title="Ticket Details"
           CloseOnOutsideClick="true"
           KeepOpenOnEscape="true">
    @if (_viewTicket != null)
    {
        <div class="view-detail-grid">
            <div class="vd-row">
                <span class="vd-label">Ticket #</span>
                <span class="vd-value ticket-id-cell">@_viewTicket.DisplayId</span>
            </div>
            <div class="vd-row">
                <span class="vd-label">Title</span>
                <span class="vd-value" style="font-weight:600">@_viewTicket.Title</span>
            </div>
            <div class="vd-row">
                <span class="vd-label">Customer</span>
                <span class="vd-value">@_viewTicket.Customer</span>
            </div>
            <div class="vd-row">
                <span class="vd-label">Assignee</span>
                <span class="vd-value">@_viewTicket.Assignee</span>
            </div>
            <div class="vd-row">
                <span class="vd-label">Priority</span>
                <span class="vd-value">
                    <span class="badge @GetPriorityClass(_viewTicket.Priority.ToString())">
                        @_viewTicket.Priority
                    </span>
                </span>
            </div>
            <div class="vd-row">
                <span class="vd-label">Status</span>
                <span class="vd-value">
                    <span class="badge @GetStatusClass(_viewTicket.Status.ToString())">
                        @GetStatusLabel(_viewTicket.Status.ToString())
                    </span>
                </span>
            </div>
            <div class="vd-row">
                <span class="vd-label">Created</span>
                <span class="vd-value">@_viewTicket.CreatedDate.ToString("MMMM d, yyyy")</span>
            </div>
            <div class="vd-row">
                <span class="vd-label">Due Date</span>
                <span class="vd-value @(_viewTicket.IsOverdue ? "overdue-text" : "")">
                    @_viewTicket.DueDate.ToString("MMMM d, yyyy")
                    @(_viewTicket.IsOverdue ? " ⚠ Overdue" : "")
                </span>
            </div>
            @if (!string.IsNullOrWhiteSpace(_viewTicket.Description))
            {
                <div class="vd-row vd-full">
                    <span class="vd-label">Description</span>
                    <span class="vd-value">@_viewTicket.Description</span>
                </div>
            }
        </div>
    }
    <IgbButton slot="footer" Variant="ButtonVariant.Flat" @onclick="CloseViewDialog">Close</IgbButton>
    <IgbButton slot="footer" Variant="ButtonVariant.Contained"
               @onclick="@(() => { CloseViewDialogAndEdit(); })">
        Edit Ticket
    </IgbButton>
</IgbDialog>

@code {
    private TicketFormDialog _formDialog = default!;
    private ConfirmDeleteDialog _confirmDialog = default!;
    private IgbDialog _viewDialog = default!;

    private IgbSelect _statusFilter   = default!;
    private IgbSelect _priorityFilter = default!;
    private IgbSelect _assigneeFilter = default!;

    private bool _isLoading = true;

    private List<Ticket> _allTickets       = new();
    private List<Ticket> _displayedTickets = new();

    // Filter state
    private string _searchText     = "";
    private string _filterStatus   = "";
    private string _filterPriority = "";
    private string _filterAssignee = "";

    private Ticket? _viewTicket;

    protected override async Task OnInitializedAsync()
    {
        TicketSvc.OnChange += async () => await InvokeAsync(RefreshAsync);
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;
        StateHasChanged();
        await Task.Delay(200); // simulate brief load

        _allTickets = await TicketSvc.GetTicketsAsync();
        ApplyFilters();

        _isLoading = false;
        StateHasChanged();
    }

    private void ApplyFilters()
    {
        // Read current filter values from refs (if available)
        var statusVal   = _statusFilter?.Value   ?? _filterStatus;
        var priorityVal = _priorityFilter?.Value ?? _filterPriority;
        var assigneeVal = _assigneeFilter?.Value ?? _filterAssignee;

        _filterStatus   = statusVal;
        _filterPriority = priorityVal;
        _filterAssignee = assigneeVal;

        var q = _allTickets.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var term = _searchText.Trim().ToLowerInvariant();
            q = q.Where(t =>
                t.Title.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                t.Customer.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                t.Assignee.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                t.DisplayId.Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(_filterStatus))
            q = q.Where(t => t.Status.ToString() == _filterStatus);

        if (!string.IsNullOrEmpty(_filterPriority))
            q = q.Where(t => t.Priority.ToString() == _filterPriority);

        if (!string.IsNullOrEmpty(_filterAssignee))
            q = q.Where(t => t.Assignee == _filterAssignee);

        _displayedTickets = q.OrderByDescending(t => t.CreatedDate).ToList();
        StateHasChanged();
    }

    private void ClearFilters()
    {
        _searchText     = "";
        _filterStatus   = "";
        _filterPriority = "";
        _filterAssignee = "";
        ApplyFilters();
    }

    // ── Dialog actions ───────────────────────────
    private async Task OpenAddDialog()
    {
        await _formDialog.OpenForCreateAsync();
    }

    private async Task OpenEditDialog(Ticket ticket)
    {
        await _formDialog.OpenForEditAsync(ticket);
    }

    private async Task OpenDeleteConfirm(Ticket ticket)
    {
        await _confirmDialog.OpenAsync(ticket);
    }

    private async Task OpenViewDialog(Ticket ticket)
    {
        _viewTicket = ticket;
        StateHasChanged();
        await _viewDialog.ShowAsync();
    }

    private async Task CloseViewDialog()
    {
        await _viewDialog.HideAsync();
    }

    private async Task CloseViewDialogAndEdit()
    {
        var t = _viewTicket;
        await _viewDialog.HideAsync();
        if (t != null)
            await _formDialog.OpenForEditAsync(t);
    }

    private async Task DeleteConfirmedAsync(Ticket ticket)
    {
        await TicketSvc.DeleteTicketAsync(ticket.Id);
        Notifications.ShowSuccess($"🗑️ Ticket deleted: {ticket.Title}");
        await RefreshAsync();
    }

    // ── Helpers ──────────────────────────────────
    private static string GetPriorityClass(string p) => p switch
    {
        "Critical" => "badge-critical",
        "High"     => "badge-high",
        "Medium"   => "badge-medium",
        "Low"      => "badge-low",
        _          => "badge-low"
    };

    private static string GetStatusClass(string s) => s switch
    {
        "New"        => "badge-new",
        "InProgress" => "badge-inprogress",
        "Waiting"    => "badge-waiting",
        "Resolved"   => "badge-resolved",
        "Closed"     => "badge-closed",
        _            => "badge-new"
    };

    private static string GetStatusLabel(string s) => s switch
    {
        "InProgress" => "In Progress",
        _            => s
    };
}
